{
  "plugins": {
    "notifications": {
      "limit": 3,
      "timeout": {
        "low": 1,
        "normal": 30
      },
      "rules": [
        {
          "match": {
            "app": "^hidden$"
          },
          "hide": true
        },
        {
          "match": {
            "app": "^urgent$"
          },
          "urgency": "critical"
        },
        {
          "match": {
            "app": "^brief$"
          },
          "timeout": 0.3
        },
        {
          "match": {
            "app": "^sticky$"
          },
          "timeout": 0
        },
        {
          "match": {
            "app": "^loud$"
          },
          "ignorePause": true
        },
        {
          "match": {
            "body": "(?<code>\\b\\d{6}\\b)"
          },
          "actions": [
            {
              "key": "c",
              "desc": "Copy {code}",
              "cmd": "echo \"$NOTIFICATION_CODE $NOTIFICATION_APP\" > \"$XDG_RUNTIME_DIR/ran\""
            }
          ]
        },
        {
          "match": {
            "app": "^runner$"
          },
          "run": "echo \"$NOTIFICATION_SUMMARY\" > \"$XDG_RUNTIME_DIR/arrived\""
        },
        {
          "match": {
            "app": "^opener$"
          },
          "default": "echo opened > \"$XDG_RUNTIME_DIR/opened\""
        }
      ]
    }
  }
}
