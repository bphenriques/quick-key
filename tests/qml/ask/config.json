{
  "plugins": {
    "approved": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s1 approve",
      "notify": ""
    },
    "stopped": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s1 work",
      "notify": ""
    },
    "trapped": {
      "type": "command",
      "file": "trapped"
    },
    "answered": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s2",
      "notify": ""
    },
    "followed": {
      "type": "command",
      "file": "followed"
    },
    "retried": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s2",
      "notify": ""
    },
    "refollowed": {
      "type": "command",
      "file": "refollowed"
    },
    "cleared": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s2",
      "notify": ""
    },
    "kept": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s2",
      "notify": ""
    },
    "renewed": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s1 work",
      "notify": ""
    },
    "visitor": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s2",
      "notify": ""
    },
    "unanswered": {
      "type": "ask",
      "ask": "true",
      "notify": ""
    },
    "chooser": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s3",
      "notify": ""
    },
    "expander": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s2",
      "notify": ""
    },
    "idle": {
      "type": "ask",
      "ask": "true",
      "notify": "",
      "glyph": "A"
    },
    "streamer": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s4",
      "notify": "",
      "toolMatch": "^mcp__agenda__(?!list_)",
      "toolRun": "echo synced > \"$XDG_RUNTIME_DIR/synced\""
    },
    "synced": {
      "type": "command",
      "file": "synced"
    },
    "s4log": {
      "type": "command",
      "file": "s4-log"
    },
    "recaller": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" s5",
      "notify": "",
      "open": "true"
    },
    "unlisted": {
      "type": "ask",
      "ask": "true",
      "notify": ""
    },
    "blind": {
      "type": "ask",
      "ask": "true",
      "notify": "",
      "encodeImage": ""
    },
    "sealed": {
      "type": "ask",
      "ask": "true",
      "notify": ""
    },
    "keyed": {
      "type": "ask",
      "ask": "true",
      "notify": ""
    }
