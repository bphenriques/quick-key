{
  "theme": {
    "name": "bubbly"
  },
  "plugins": {
    "lastLine": {
      "type": "command",
      "read": "printf 'first\\nsecond\\n'",
      "title": "Last",
      "activate": "echo on > \"$XDG_RUNTIME_DIR/activated\""
    },
    "activated": {
      "type": "command",
      "file": "activated"
    },
    "clicked": {
      "type": "command",
      "read": "cat \"$XDG_RUNTIME_DIR/clicked\" 2>/dev/null || echo no",
      "activate": "sleep 0.2; echo yes > \"$XDG_RUNTIME_DIR/clicked\""
    },
    "watcher": {
      "type": "command",
      "watch": "echo up",
      "glyph": "W"
    },
    "chooser": {
      "type": "command",
      "select": "sleep 0.3; echo picked > \"$XDG_RUNTIME_DIR/chose-$1\"; :"
    },
    "choseA": {
      "type": "command",
      "file": "chose-a"
    },
    "choseB": {
      "type": "command",
      "file": "chose-b"
    },
    "choseC": {
      "type": "command",
      "file": "chose-c"
    },
    "wallpaper": {
      "file": "wallpaper"
    },
    "custom": {},
    "folded": {
      "greeting": "hi",
      "unknown": true
    },
    "broken": {
      "type": "missing"
    },
    "paused": {
      "type": "command",
      "read": "echo true",
      "show": {
        "true": {
          "glyph": "B",
          "tone": "alert",
          "active": true
        },
        "false": {
          "glyph": "b"
        }
      }
    },
    "override": {
      "type": "command",
      "read": "echo '{\"value\":\"x\",\"text\":\"live\"}'",
      "show": {
        "x": {
          "text": "shown",
          "detail": "d"
        }
      }
    },
    "layouts": {
      "type": "command",
      "read": "echo '{\"value\":\"b\",\"enabled\":[\"a\",\"b\"]}'",
      "items": [
        {
          "id": "a",
          "label": "A"
        },
        {
          "id": "b",
          "label": "B",
          "icon": "I"
        },
        {
          "id": "c"
        }
      ]
    },
    "ticker": {
      "type": "command",
      "read": "n=$(cat \"$XDG_RUNTIME_DIR/tick\" 2>/dev/null || echo 0); echo $((n + 1)) | tee \"$XDG_RUNTIME_DIR/tick\"",
      "every": 1
    },
    "tasks": {
      "file": "tasks",
      "done": "sh \"$XDG_CONFIG_HOME/quick-key/tasks.sh\" done",
      "reopen": "sh \"$XDG_CONFIG_HOME/quick-key/tasks.sh\" reopen",
      "sync": "sh \"$XDG_CONFIG_HOME/quick-key/tasks.sh\" sync",
      "remind": "sh \"$XDG_CONFIG_HOME/quick-key/tasks.sh\" remind",
      "add": "sh \"$XDG_CONFIG_HOME/quick-key/tasks.sh\" add"
    },
    "added": {
      "type": "command",
      "file": "added"
    },
    "synced": {
      "type": "command",
      "file": "synced"
    },
    "reminded": {
      "type": "command",
      "file": "reminded"
    },
    "repeated": {
      "type": "command",
      "watch": "echo same; echo same; echo same; sleep 60"
    },
    "finisher": {
      "type": "command",
      "watch": "echo '{\"phase\":\"done\",\"text\":\"built\"}'"
    },
    "worker": {
      "type": "command",
      "watch": "echo '{\"phase\":\"working\",\"text\":\"building\"}'"
    },
    "later": {
      "type": "command",
      "read": "echo '{\"phase\":\"later\",\"kind\":\"nope\"}'"
    }
  },
  "daemons": {
    "list": "echo org.freedesktop.UPower.PowerProfiles"
  }
}
