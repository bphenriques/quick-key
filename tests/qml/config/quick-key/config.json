{
  "calendar": {
    "remind": ""
  },
  "plugins": {
    "lastLine": {
      "source": "command",
      "settings": {
        "read": "printf 'first\\nsecond\\n'"
      }
    },
    "watcher": {
      "source": "command",
      "settings": {
        "watch": "echo up"
      }
    },
    "wallpaper": {
      "settings": {
        "file": "wallpaper"
      }
    },
    "devices": {
      "source": "command",
      "settings": {
        "read": "echo '{\"items\": [{\"id\": \"a-1\"}, {\"id\": \"b-2\"}]}'"
      }
    },
    "custom": {},
    "folded": {
      "settings": {
        "greeting": "hi",
        "unknown": true
      }
    },
    "broken": {
      "source": "missing"
    },
    "paused": {
      "source": "command",
      "settings": {
        "read": "echo true",
        "show": {
          "true": {
            "glyph": "B",
            "tone": "alert",
            "active": true
          },
          "false": {
            "glyph": "b"
          }
        }
      }
    },
    "override": {
      "source": "command",
      "settings": {
        "read": "echo '{\"value\":\"x\",\"text\":\"live\"}'",
        "show": {
          "x": {
            "text": "shown",
            "detail": "d"
          }
        }
      }
    },
    "layouts": {
      "source": "command",
      "settings": {
        "read": "echo '{\"value\":\"b\",\"enabled\":[\"a\",\"b\"]}'",
        "items": [
          {
            "id": "a",
            "label": "A"
          },
          {
            "id": "b",
            "label": "B",
            "icon": "I"
          },
          {
            "id": "c"
          }
        ]
      }
    },
    "ticker": {
      "source": "command",
      "settings": {
        "read": "n=$(cat \"$XDG_RUNTIME_DIR/tick\" 2>/dev/null || echo 0); echo $((n + 1)) | tee \"$XDG_RUNTIME_DIR/tick\"",
        "every": 1
      }
    }
  }
}
