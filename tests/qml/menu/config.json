{
  "plugins": {
    "devices": {
      "type": "command",
      "read": "echo '{\"items\": [{\"id\": \"a-1\"}, {\"id\": \"b-2\"}]}'",
      "select": "sh -c 'echo \"$1\" > \"$XDG_RUNTIME_DIR/picked\"' sh"
    },
    "picked": {
      "type": "command",
      "file": "picked"
    },
    "followed": {
      "type": "command",
      "file": "followed"
    },
    "agent": {
      "type": "ask",
      "ask": "sh \"$XDG_CONFIG_HOME/quick-key/agent.sh\" \"$1\"",
      "notify": ""
    },
    "nothing": {
      "type": "command",
      "read": "echo '{\"items\": [], \"empty\": \"Nothing found\"}'"
    }
  },
  "menu": {
    "picker": "sed -n 2p",
    "header": {
      "left": [
        {
          "key": "x",
          "desc": "X",
          "cmd": "echo bar > \"$XDG_RUNTIME_DIR/picked\""
        }
      ],
      "center": [],
      "right": [
        {
          "desc": "Devices",
          "list": "devices",
          "limit": 1
        }
      ]
    }
  }
}
