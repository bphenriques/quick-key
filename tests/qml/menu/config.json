{
  "plugins": {
    "devices": {
      "type": "command",
      "read": "echo '{\"items\": [{\"id\": \"a-1\"}, {\"id\": \"b-2\"}]}'",
      "select": "sh -c 'echo \"$1\" > \"$XDG_RUNTIME_DIR/picked\"' sh"
    },
    "many": {
      "type": "command",
      "read": "python3 -c 'import json; print(json.dumps({\"items\": [{\"id\": str(i), \"label\": \"Item %d\" % i} for i in range(10000)]}))'"
    },
    "ordered": {
      "type": "command",
      "file": "ordered"
    },
    "acting": {
      "type": "command",
      "read": "echo '{\"items\": [{\"id\": \"a\", \"label\": \"A\", \"verb\": \"open\", \"actions\": [{\"key\": \"d\", \"desc\": \"Delete\"}]}]}'",
      "run": "sh -c 'echo \"$1 $2\" > \"$XDG_RUNTIME_DIR/picked\"' sh"
    },
    "picked": {
      "type": "command",
      "file": "picked"
    },
    "followed": {
      "type": "command",
      "file": "followed"
    },
    "agent": {
      "type": "ask",
      "ask": "python3 \"$XDG_CONFIG_HOME/quick-key/agent.py\" m1",
      "notify": ""
    },
    "nothing": {
      "type": "command",
      "read": "echo '{\"items\": [], \"empty\": \"Nothing found\"}'"
    },
    "hides": {
      "type": "command",
      "read": "echo '{\"items\":[{\"id\":\"a\"},{\"id\":\"b\",\"hidden\":true}]}'"
    },
    "clicked": {
      "type": "command",
      "activate": "echo clicked > \"$XDG_RUNTIME_DIR/picked\""
    },
    "keyed": {
      "type": "command"
    }
  },
  "menu": {
    "entries": [
      {
        "key": "a",
        "desc": "Audio",
        "submenu": [
          {
            "key": "a",
            "desc": "Again",
            "submenu": []
          }
        ],
        "header": {
          "left": [
            {
              "key": "v",
              "desc": "Vee",
              "cmd": "true"
            }
          ]
        }
      }
    ],
    "header": {
      "left": [
        {
          "key": "x",
          "desc": "X",
          "cmd": "echo bar > \"$XDG_RUNTIME_DIR/picked\""
        },
        {
          "key": [
            "Down",
            "Up"
          ],
          "desc": "Volume",
          "cmd": [
            "true",
            "true"
          ],
          "keepOpen": true
        },
        {
          "key": "k",
          "desc": "Clicked",
          "status": "clicked"
        }
      ],
      "center": [],
      "right": [
        {
          "desc": "Devices",
          "list": "devices",
          "limit": 1
        }
      ]
    }
  }
}
